# Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:pswd@localhost:5432/law_firm_db


# MongoDB Configuration (Optional - for evidence files)
#MONGODB_URL=mongodb://localhost:27017
#MONGODB_DB=law_firm_documents

# JWT Authentication
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173"]
# Fill an empty SQLite database with the demo firm. Leave off for real use.
#SEED_SAMPLE_DATA=false
